# Redis Configuration
# Connection string for Redis cache (optional - falls back to in-memory cache if not provided)
REDIS_URL=redis://localhost:6379

# BGG API Configuration
# Base URL for BoardGameGeek API (optional - defaults to https://boardgamegeek.com/xmlapi2)
BGG_API_BASE_URL=https://boardgamegeek.com/xmlapi2

# Cron Job Security (optional)
# Secret key for securing the /api/keepalive endpoint
CRON_SECRET=your-secret-key-here

# Server Configuration
# Port for local development (optional - defaults to 4000)
PORT=4000

# Node Environment
# Automatically set by Vercel in production
NODE_ENV=development
